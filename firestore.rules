rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Customers may submit orders from the public website.
      allow create: if request.resource.data.status == 'New';
      // Only signed-in Firebase users can view or manage orders.
      allow read, update, delete: if request.auth != null;
    }

    match /catalog/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteAnalytics/{dateId} {
      // Public visitors may only add one view to a YYYY-MM-DD aggregate.
      allow create: if dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['views'])
        && request.resource.data.views == 1;
      allow update: if dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;
      allow read: if request.auth != null;
    }
  }
}
